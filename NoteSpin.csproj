<Project Sdk="Microsoft.NET.Sdk">

  <!-- .NET Framework 4.8 is built into Windows 10/11, so the app needs nothing installed.
       The pages in web\ are compiled into the exe and served to WebView2 from memory. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>NoteSpin</AssemblyName>
    <RootNamespace>NoteSpin</RootNamespace>
    <ApplicationIcon>favicon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.1.0</Version>
    <Product>NoteSpin</Product>
    <AssemblyTitle>NoteSpin</AssemblyTitle>
    <Description>Sticky notes on a spinning card wheel</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <DefaultItemExcludes>$(DefaultItemExcludes);dist\**;CONTEXT\**;tools\**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="Microsoft.VisualBasic" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="web\**\*" Exclude="web\**\*.md" LogicalName="web/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="favicon.ico" LogicalName="favicon.ico" />
    <None Update="LICENSES.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
